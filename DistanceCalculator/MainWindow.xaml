<Window x:Class="DistanceCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:DistanceCalculator.ViewModels"
        xmlns:cv="clr-namespace:DistanceCalculator.Converters"
        mc:Ignorable="d"
        Title="Google Distance Calculator"
        Height="900" Width="1200" MinHeight="750" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <cv:NullToVisibilityConverter x:Key="NullToVis" />
        <cv:StatusToColorConverter x:Key="StatusToColor" />
        <cv:StatusToIconConverter x:Key="StatusToIcon" />
        <cv:ApiKeyValidToColorConverter x:Key="ApiValidColor" />
        <cv:DoubleFormatConverter x:Key="DoubleFormat" />

        <Style x:Key="CardStyle" TargetType="materialDesign:Card">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="ColumnLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="GroupBox" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryDark"
                                   materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid Margin="20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="MapMarkerDistance" Width="32" Height="32"
                                            VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Google Distance Calculator"
                                   FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Calcola distanze da file Excel tramite Google Maps API"
                                   FontSize="11" Opacity="0.8" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding ClearCommand}"
                        ToolTip="Ricomincia da capo"
                        VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Refresh" />
                </Button>
            </Grid>
        </materialDesign:ColorZone>

        <!-- ===== MAIN CONTENT ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,8">
            <StackPanel>

                <!-- === API KEY === -->
                <materialDesign:Card Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="Key" Width="18" Height="18"
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Configurazione API Google Maps" Style="{StaticResource SectionHeader}"
                                       Margin="0" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     materialDesign:HintAssist.Hint="Chiave API Google Maps Distance Matrix"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,12,0"
                                     FontFamily="Consolas" FontSize="12" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding ValidateApiKeyCommand}"
                                    Height="48" Padding="16,0"
                                    VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckDecagram" Width="16" Height="16"
                                                            VerticalAlignment="Center" Margin="0,0,6,0"
                                                            Visibility="{Binding IsValidatingKey, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    <materialDesign:PackIcon Kind="Loading" Width="16" Height="16"
                                                            VerticalAlignment="Center" Margin="0,0,6,0"
                                                            Visibility="{Binding IsValidatingKey, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="Verifica" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding ApiKeyStatus, Converter={StaticResource NullToVis}}">
                            <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16"
                                                    Foreground="{Binding IsApiKeyValid, Converter={StaticResource ApiValidColor}}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0"
                                                    Visibility="{Binding IsApiKeyValid, Converter={StaticResource BoolToVis}}" />
                            <materialDesign:PackIcon Kind="AlertCircle" Width="16" Height="16"
                                                    Foreground="{Binding IsApiKeyValid, Converter={StaticResource ApiValidColor}}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0"
                                                    Visibility="{Binding IsApiKeyValid, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <TextBlock Text="{Binding ApiKeyStatus}"
                                       Foreground="{Binding IsApiKeyValid, Converter={StaticResource ApiValidColor}}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- === FILE SELECTION === -->
                <materialDesign:Card Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18"
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="File Excel" Style="{StaticResource SectionHeader}"
                                       Margin="0" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Row="1" Height="80"
                                Name="DropZone"
                                BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                                BorderThickness="2" CornerRadius="8" Margin="0,0,0,12"
                                Cursor="Hand" MouseLeftButtonDown="DropZone_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"><Setter.Value><SolidColorBrush Color="#F0F4FF"/></Setter.Value></Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background"><Setter.Value><SolidColorBrush Color="#E3EEFF"/></Setter.Value></Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloudDownload" Width="28" Height="28"
                                                        Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                        VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Trascina il file Excel qui"
                                               FontSize="14" FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                    <TextBlock Text="oppure clicca per sfogliare — .xlsx, .xls"
                                               FontSize="11" Opacity="0.6" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="FileCheckOutline"
                                                    Width="20" Height="20" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding IsFileLoaded, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding FileName}" VerticalAlignment="Center"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                       Visibility="{Binding IsFileLoaded, Converter={StaticResource BoolToVis}}" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding BrowseFileCommand}"
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpen" Width="16" Height="16"
                                                            VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Sfoglia" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </materialDesign:Card>

                <!-- === COLUMN CONFIG (visible when file loaded) === -->
                <materialDesign:Card Style="{StaticResource CardStyle}"
                                     Visibility="{Binding IsFileLoaded, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <materialDesign:PackIcon Kind="TableCog" Width="18" Height="18"
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Configurazione Colonne" Style="{StaticResource SectionHeader}"
                                       Margin="0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Row 1: Date + Generic Desc -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Data tragitto" Style="{StaticResource ColumnLabel}" />
                                <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          ItemsSource="{Binding OptionalColumnOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding DateColumnIndex}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Descrizione generica viaggio" Style="{StaticResource ColumnLabel}" />
                                <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          ItemsSource="{Binding OptionalColumnOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding GenericDescColumnIndex}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                <CheckBox Content="Prima riga = intestazioni"
                                          IsChecked="{Binding HasHeaderRow}"
                                          Style="{StaticResource MaterialDesignCheckBox}" />
                            </StackPanel>
                        </Grid>

                        <!-- Divider -->
                        <Separator Margin="0,0,0,12" />

                        <!-- Row 2: Departure -->
                        <Border Style="{StaticResource GroupBox}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Colonna Partenza *" Style="{StaticResource ColumnLabel}" />
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              ItemsSource="{Binding ColumnOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Index"
                                              SelectedValue="{Binding DepartureColumnIndex}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                    <CheckBox Content="Desc.+indirizzo stessa cella"
                                              IsChecked="{Binding DepartureCombinedCell}"
                                              Style="{StaticResource MaterialDesignCheckBox}" />
                                </StackPanel>

                                <!-- Separator choice (visible when combined) -->
                                <StackPanel Grid.Column="4"
                                            Visibility="{Binding DepartureCombinedCell, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Separatore" Style="{StaticResource ColumnLabel}" />
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              ItemsSource="{Binding SeparatorOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedSeparator}" />
                                </StackPanel>

                                <!-- Separate desc column (visible when NOT combined) -->
                                <StackPanel Grid.Column="4"
                                            Visibility="{Binding DepartureCombinedCell, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <TextBlock Text="Colonna Descrizione Partenza" Style="{StaticResource ColumnLabel}" />
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              ItemsSource="{Binding OptionalColumnOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Index"
                                              SelectedValue="{Binding DepDescColumnIndex}" />
                                </StackPanel>

                                <!-- Preview chip -->
                                <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="0,12,0,0">
                                    <materialDesign:Chip Content="Partenza"
                                                         Icon="{materialDesign:PackIcon Kind=MapMarker}"
                                                         Background="{DynamicResource PrimaryHueLightBrush}"
                                                         Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"
                                                         IsEnabled="False" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Row 3: Arrival -->
                        <Border Style="{StaticResource GroupBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Colonna Arrivo *" Style="{StaticResource ColumnLabel}" />
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              ItemsSource="{Binding ColumnOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Index"
                                              SelectedValue="{Binding ArrivalColumnIndex}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                    <CheckBox Content="Desc.+indirizzo stessa cella"
                                              IsChecked="{Binding ArrivalCombinedCell}"
                                              Style="{StaticResource MaterialDesignCheckBox}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4"
                                            Visibility="{Binding ArrivalCombinedCell, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Separatore" Style="{StaticResource ColumnLabel}" />
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              ItemsSource="{Binding SeparatorOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedSeparator}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4"
                                            Visibility="{Binding ArrivalCombinedCell, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <TextBlock Text="Colonna Descrizione Arrivo" Style="{StaticResource ColumnLabel}" />
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              ItemsSource="{Binding OptionalColumnOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Index"
                                              SelectedValue="{Binding ArrDescColumnIndex}" />
                                </StackPanel>

                                <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="0,12,0,0">
                                    <materialDesign:Chip Content="Arrivo"
                                                         Icon="{materialDesign:PackIcon Kind=MapMarkerCheck}"
                                                         Background="#E8F5E9"
                                                         Foreground="#2E7D32"
                                                         IsEnabled="False" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Info hint about combined cell -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                    Visibility="{Binding DepartureCombinedCell, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14"
                                                    VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6" />
                            <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap">
                                <Run Text="Modalità cella combinata attiva: l'app estrae la descrizione separando con il carattere scelto (o automaticamente con a capo, " />
                                <Run Text="«" /><Run Text=" - " /><Run Text="»" />
                                <Run Text=" o parole chiave stradali: Via, Viale, Piazza…)" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14"
                                                    VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6" />
                            <TextBlock Text="{Binding ProcessedInfo}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- === DATA GRID PREVIEW (visible when file loaded) === -->
                <materialDesign:Card Style="{StaticResource CardStyle}"
                                     Visibility="{Binding IsFileLoaded, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="240" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="TableSearch" Width="18" Height="18"
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Anteprima Dati" Style="{StaticResource SectionHeader}"
                                       Margin="0" VerticalAlignment="Center" />
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Rows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  materialDesign:DataGridAssist.CellPadding="8,5"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="8,7"
                                  Style="{StaticResource MaterialDesignDataGrid}"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>

                                <!-- Status icon -->
                                <DataGridTemplateColumn Header="" Width="40" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <materialDesign:PackIcon
                                                Kind="{Binding Status, Converter={StaticResource StatusToIcon}}"
                                                Width="16" Height="16"
                                                Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="44" />
                                <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="90" />
                                <DataGridTextColumn Header="Descrizione" Binding="{Binding GenericDescription}" Width="120" />

                                <!-- Departure -->
                                <DataGridTemplateColumn Header="Partenza" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DepartureDescription}"
                                                           FontSize="10" Opacity="0.6"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding DepartureDescription, Converter={StaticResource NullToVis}}" />
                                                <TextBlock Text="{Binding DepartureAddress}"
                                                           FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Arrival -->
                                <DataGridTemplateColumn Header="Arrivo" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ArrivalDescription}"
                                                           FontSize="10" Opacity="0.6"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding ArrivalDescription, Converter={StaticResource NullToVis}}" />
                                                <TextBlock Text="{Binding ArrivalAddress}"
                                                           FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Distance + error -->
                                <DataGridTemplateColumn Header="Distanza" Width="120" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding DistanceDisplay}"
                                                           FontWeight="Medium"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                           HorizontalAlignment="Right"
                                                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                                                <TextBlock Text="{Binding ErrorMessage}"
                                                           FontSize="10"
                                                           Foreground="#E53935"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>

                <!-- === RESULTS CARD (visible when has results) === -->
                <materialDesign:Card Style="{StaticResource CardStyle}"
                                     Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MapMarkerDistance" Width="28" Height="28"
                                                        Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                        VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Totale Distanza Percorsa" FontSize="12" Opacity="0.7" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TotalDistanceKm, Converter={StaticResource DoubleFormat}}"
                                                   FontSize="32" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                        <TextBlock Text=" km"
                                                   FontSize="18" FontWeight="Light"
                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                   VerticalAlignment="Bottom" Margin="4,0,0,4" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                        Visibility="{Binding SaveSuccess, Converter={StaticResource BoolToVis}}">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16"
                                                        Foreground="#43A047" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Risultati salvati nel file Excel"
                                           Foreground="#43A047" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding SaveResultsCommand}"
                                Height="52" Padding="20,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18"
                                                        VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Salva Risultati" VerticalAlignment="Center" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== BOTTOM ACTION BAR ===== -->
        <materialDesign:Card Grid.Row="2"
                             materialDesign:ElevationAssist.Elevation="Dp4"
                             Padding="20,12" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <materialDesign:PackIcon Kind="Information" Width="14" Height="14"
                                                VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6"
                                                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <materialDesign:PackIcon Kind="ProgressClock" Width="14" Height="14"
                                                VerticalAlignment="Center" Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                    <ProgressBar Value="{Binding Progress}" Height="4"
                                 Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"
                        Foreground="#E53935" BorderBrush="#E53935"
                        Height="42" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Stop" Width="16" Height="16"
                                                VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Annulla" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding CalculateCommand}"
                        IsEnabled="{Binding CanCalculate}"
                        Height="42" Padding="24,0" FontSize="14">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="RouteVariant" Width="18" Height="18"
                                                VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Calcola Distanze" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
